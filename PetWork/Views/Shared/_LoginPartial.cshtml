@{
    var isLoggedIn = Context.Session.GetInt32("UserId").HasValue;
    var isAdmin = string.Equals(Context.Session.GetString("IsAdmin"), "True", StringComparison.OrdinalIgnoreCase);
    var username = Context.Session.GetString("Username") ?? "Üye";
    var initial = string.IsNullOrWhiteSpace(username) ? "P" : username[..1].ToUpperInvariant();
}
@if (isLoggedIn)
{
    <div class="dropdown user-menu">
        <button class="user-menu-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="user-initial" aria-hidden="true">@initial</span>
            <span class="user-menu-copy"><strong>@username</strong><small>@(isAdmin ? "Yönetici" : "Topluluk üyesi")</small></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end border-0">
            @if (isAdmin)
            {
                <li><a class="dropdown-item admin-menu-link" asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-wand-magic-sparkles me-2"></i>Yönetim alanı</a></li>
                <li><hr class="dropdown-divider" /></li>
            }
            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="fa-regular fa-user me-2"></i>Profilim</a></li>
            <li><a class="dropdown-item" asp-controller="Questions" asp-action="Ask"><i class="fa-regular fa-message me-2"></i>Soru veya deneyim paylaş</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Çıkış yap</a></li>
        </ul>
    </div>
}
else
{
    <div class="guest-actions">
        <a class="btn btn-link guest-login" asp-controller="Account" asp-action="Login">Giriş yap</a>
        <a class="btn btn-petwork-primary btn-sm" asp-controller="Account" asp-action="Register">Aramıza katıl</a>
    </div>
}
