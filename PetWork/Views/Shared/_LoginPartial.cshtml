@{
    bool isLoggedIn = Context.Session.GetInt32("UserId").HasValue;
    bool isAdmin = string.Equals(Context.Session.GetString("IsAdmin"), "True", StringComparison.OrdinalIgnoreCase);
}

@if (isLoggedIn)
{
    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="~/img/user-profile.jpg" alt="Profil" class="rounded-circle" width="30" height="30">
                <span class="ms-1">@Context.Session.GetString("Username")</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                @if (isAdmin)
                {
                    <li><a class="dropdown-item fw-semibold text-primary" asp-controller="Admin" asp-action="Index"><i class="fas fa-user-shield me-2"></i>Admin Paneli</a></li>
                    <li><hr class="dropdown-divider"></li>
                }
                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profilim</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Questions" asp-action="Ask">Soru Sor</a></li>
                <li><a class="dropdown-item" asp-controller="Recipes" asp-action="Add">Tarif Ekle</a></li>
                <li><a class="dropdown-item" asp-controller="Blog" asp-action="Add">Blog Yazısı Ekle</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Pet" asp-action="Index">Evcil Hayvanlarım</a></li>
                <li><a class="dropdown-item" asp-controller="Notification" asp-action="Index">Bildirimler</a></li>
                <li><a class="dropdown-item" asp-controller="Favorite" asp-action="Index">Favorilerim</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Çıkış Yap</a></li>
            </ul>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Login">Giriş Yap</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-light" asp-controller="Account" asp-action="Register">Üye Ol</a>
        </li>
    </ul>
} 
