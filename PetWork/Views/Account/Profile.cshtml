@model User
@{
    ViewData["Title"] = "Profil";
}

<div class="container py-5">
    <div class="row">
        <!-- Sidebar Column -->
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    <img src="@PetWork.Services.MediaUrlResolver.Resolve(Url, Model.ProfileImage, "img/user-profile.jpg")" alt="@Model.Username" class="rounded-circle img-fluid mb-3" style="width: 150px; height: 150px; object-fit: cover;">
                    <h3 class="mb-1">@Model.Username</h3>
                    <p class="text-muted">@Model.Email</p>
                    
                    <div class="d-flex justify-content-center mb-3">
                        <span class="badge bg-primary me-2 p-2">
                            <i class="fas fa-medal me-1"></i> @Model.ExperiencePoints XP
                        </span>
                        <span class="badge bg-success p-2">
                            <i class="fas fa-calendar-alt me-1"></i> Üye: @Model.RegistrationDate.ToString("MMMM yyyy")
                        </span>
                    </div>
                    
                    <div class="d-grid gap-2 mt-3">
                        <a asp-controller="Account" asp-action="EditProfile" class="btn btn-primary">
                            <i class="fas fa-edit me-1"></i> Profili Düzenle
                        </a>
                    </div>
                </div>
                <div class="list-group list-group-flush">
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-question-circle me-2"></i> Sorularım
                        </div>
                        <span class="badge bg-primary rounded-pill">@(Model.Questions?.Count ?? 0)</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-comment me-2"></i> Cevaplarım
                        </div>
                        <span class="badge bg-primary rounded-pill">@(Model.Answers?.Count ?? 0)</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-paw me-2"></i> Evcil Hayvanlarım
                        </div>
                        <span class="badge bg-primary rounded-pill">@(Model.Pets?.Count ?? 0)</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-bookmark me-2"></i> Favorilerim
                        </div>
                        <span class="badge bg-primary rounded-pill">0</span>
                    </a>
                </div>
            </div>
            
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Rozetlerim</h5>
                </div>
                <div class="card-body">
                    @if (Model.Badges != null && Model.Badges.Any())
                    {
                        <div class="d-flex flex-wrap gap-3 justify-content-center">
                            @foreach (var badge in Model.Badges)
                            {
                                <div class="text-center" title="@badge.Description">
                                    <img src="~/@badge.IconUrl" alt="@badge.Name" class="img-fluid" style="width: 50px; height: 50px;">
                                    <p class="small mb-0">@badge.Name</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-center mb-0">Henüz rozet kazanmadınız. Topluluğa katılarak rozetler kazanabilirsiniz!</p>
                    }
                </div>
            </div>
        </div>
        
        <!-- Main Content Column -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">Hakkımda</h4>
                </div>
                <div class="card-body">
                    @if (string.IsNullOrEmpty(Model.Bio))
                    {
                        <p class="mb-0 text-muted fst-italic">Profil bilgisi henüz eklenmemiş.</p>
                    }
                    else
                    {
                        <p class="mb-0">@Model.Bio</p>
                    }
                </div>
            </div>
            
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Evcil Hayvanlarım</h4>
                    <a href="#" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus-circle me-1"></i> Evcil Hayvan Ekle
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.Pets != null && Model.Pets.Any())
                    {
                        <div class="row">
                            @foreach (var pet in Model.Pets)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100">
                                        <div class="row g-0">
                                            <div class="col-4">
                                                <img src="@PetWork.Services.MediaUrlResolver.Resolve(Url, pet.ProfileImage, "img/pet-default.jpg")" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="@pet.Name">
                                            </div>
                                            <div class="col-8">
                                                <div class="card-body">
                                                    <h5 class="card-title mb-1">@pet.Name</h5>
                                                    <p class="card-text small text-muted mb-2">@pet.Type - @pet.Breed</p>
                                                    <p class="card-text small">
                                                        @if (pet.DateOfBirth.HasValue)
                                                        {
                                                            var age = DateTime.Now.Year - pet.DateOfBirth.Value.Year;
                                                            @($"{age} yaşında")
                                                        }
                                                    </p>
                                                    <a href="#" class="btn btn-sm btn-outline-primary">Detaylar</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-paw fa-3x text-muted mb-3"></i>
                            <p class="mb-3">Henüz evcil hayvan eklemediniz.</p>
                            <a href="#" class="btn btn-primary">
                                <i class="fas fa-plus-circle me-1"></i> İlk Evcil Hayvanınızı Ekleyin
                            </a>
                        </div>
                    }
                </div>
            </div>
            
            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">Son Aktiviteler</h4>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-marker bg-primary">
                                <i class="fas fa-question-circle"></i>
                            </div>
                            <div class="timeline-content">
                                <h5 class="mb-1">Yeni Soru Sordu</h5>
                                <p class="mb-0"><a href="#">Köpeğim için sağlıklı ödül maması önerileri?</a></p>
                                <small class="text-muted">2 gün önce</small>
                            </div>
                        </div>
                        
                        <div class="timeline-item">
                            <div class="timeline-marker bg-success">
                                <i class="fas fa-comment"></i>
                            </div>
                            <div class="timeline-content">
                                <h5 class="mb-1">Bir Soruya Cevap Verdi</h5>
                                <p class="mb-0"><a href="#">Kedilerde tırnak kesimi hakkında</a></p>
                                <small class="text-muted">1 hafta önce</small>
                            </div>
                        </div>
                        
                        <div class="timeline-item">
                            <div class="timeline-marker bg-info">
                                <i class="fas fa-paw"></i>
                            </div>
                            <div class="timeline-content">
                                <h5 class="mb-1">Yeni Evcil Hayvan Ekledi</h5>
                                <p class="mb-0">Boncuk - Kedi, Scottish Fold</p>
                                <small class="text-muted">2 ay önce</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Timeline styling */
    .timeline {
        position: relative;
        padding-left: 30px;
    }
    
    .timeline-item {
        position: relative;
        margin-bottom: 25px;
    }
    
    .timeline-item:last-child {
        margin-bottom: 0;
    }
    
    .timeline-marker {
        position: absolute;
        width: 30px;
        height: 30px;
        left: -45px;
        top: 0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }
    
    .timeline:before {
        content: '';
        position: absolute;
        top: 0;
        left: -30px;
        height: 100%;
        width: 2px;
        background-color: #dee2e6;
    }
</style>
