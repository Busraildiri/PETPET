@model PetWork.Models.Guide

@{
    ViewData["Title"] = Model.Title;
}

<section class="py-5">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a asp-controller="Guide" asp-action="Index">Bakım Rehberleri</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-lg-8">
                <h1 class="mb-3">@Model.Title</h1>
                
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="d-flex align-items-center">
                        <img src="@PetWork.Services.MediaUrlResolver.Resolve(Url, Model.User?.ProfileImage, "img/user-profile.jpg")" alt="@Model.User?.Username" class="rounded-circle me-2" width="40" height="40">
                        <span class="text-muted">@Model.User?.Username</span>
                    </div>
                    <div>
                        <span class="badge @(Model.AnimalType == "Kedi" ? "bg-success" : (Model.AnimalType == "Köpek" ? "bg-primary" : "bg-info"))">@Model.AnimalType</span>
                        <span class="badge bg-secondary ms-2">@Model.Category</span>
                        <span class="badge @(Model.Level == "Başlangıç" ? "bg-success" : (Model.Level == "Orta" ? "bg-warning" : "bg-danger")) ms-2">@Model.Level</span>
                        <span class="text-muted ms-3 small"><i class="far fa-eye me-1"></i> @Model.ViewCount görüntüleme</span>
                    </div>
                </div>
                
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Rehber Açıklaması</h5>
                    </div>
                    <div class="card-body">
                        <p>@Model.Description</p>
                    </div>
                </div>
                
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">İçerik</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.Content))
                        {
                            <div class="content-text">@Model.Content</div>
                        }
                        else
                        {
                            <p class="text-muted">İçerik eklenmemiş.</p>
                        }
                    </div>
                </div>

                <div class="alert alert-info">
                    <h5><i class="fas fa-info-circle me-2"></i> Bilgilendirme</h5>
                    <p class="mb-0">Bu rehber genel bilgi amaçlıdır. Her evcil hayvan bireysel farklılıklar gösterebilir. Karşılaştığınız özel durumlar için veteriner hekiminize danışmanız önerilir.</p>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Benzer Rehberler</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <p class="text-muted">Bu hayvan türü için daha fazla rehber:</p>
                            <a asp-controller="Guide" asp-action="Index" asp-route-animalType="@Model.AnimalType" class="btn btn-outline-primary w-100">
                                @Model.AnimalType Rehberleri
                            </a>
                        </div>
                        <div>
                            <p class="text-muted">Bu kategori için daha fazla rehber:</p>
                            <a asp-controller="Guide" asp-action="Index" asp-route-category="@Model.Category" class="btn btn-outline-secondary w-100">
                                @Model.Category Rehberleri
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">İlgili Bağlantılar</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group">
                            <a asp-controller="Recipes" asp-action="Index" asp-route-animalType="@Model.AnimalType" class="list-group-item list-group-item-action">
                                <i class="fas fa-utensils me-2"></i> @Model.AnimalType Tarifleri
                            </a>
                            <a asp-controller="Diseases" asp-action="Index" asp-route-animalType="@Model.AnimalType" class="list-group-item list-group-item-action">
                                <i class="fas fa-stethoscope me-2"></i> @Model.AnimalType Hastalıkları
                            </a>
                            <a asp-controller="Questions" asp-action="Index" class="list-group-item list-group-item-action">
                                <i class="fas fa-question-circle me-2"></i> Soru Sor
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Paylaş</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-around">
                            <a href="#" class="text-primary"><i class="fab fa-facebook-f fa-2x"></i></a>
                            <a href="#" class="text-info"><i class="fab fa-twitter fa-2x"></i></a>
                            <a href="#" class="text-danger"><i class="fab fa-pinterest fa-2x"></i></a>
                            <a href="#" class="text-success"><i class="fab fa-whatsapp fa-2x"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (ViewBag.ExternalSource is PetWork.Models.ExternalContentSource source) { <partial name="_ExternalSourceAttribution" model="source" /> }
</section> 
