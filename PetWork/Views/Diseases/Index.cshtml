@model PetWork.Models.ViewModels.DiseaseViewModel

@{
    ViewData["Title"] = "Hayvan Hastalıkları Bilgi Bankası";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="mb-3">Hayvan Hastalıkları Bilgi Bankası</h1>
                <p class="lead">Evcil hayvan hastalıkları hakkında bilgi edinebileceğiniz kapsamlı rehber</p>
            </div>
            <div class="col-md-4 text-md-end">
                <button class="btn btn-outline-primary mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
                    <i class="fas fa-filter me-2"></i> Filtreleme Seçenekleri
                </button>
            </div>
        </div>
        
        <div class="collapse mb-4" id="filterCollapse">
            <div class="card card-body">
                <form asp-controller="Diseases" asp-action="Index" method="get" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Hayvan Türü</label>
                        <select name="animalType" class="form-select">
                            <option value="">Tümü</option>
                            @foreach (var animalType in Model.AnimalTypes)
                            {
                                <option value="@animalType" selected="@(Model.SelectedAnimalType == animalType)">@animalType</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Kategori</label>
                        <select name="category" class="form-select">
                            <option value="">Tümü</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category" selected="@(Model.SelectedCategory == category)">@category</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Risk Seviyesi</label>
                        <select name="severityLevel" class="form-select">
                            <option value="">Tümü</option>
                            @foreach (var severityLevel in Model.SeverityLevels)
                            {
                                <option value="@severityLevel" selected="@(Model.SelectedSeverityLevel == severityLevel)">@severityLevel</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Sıralama</label>
                        <select name="sortOption" class="form-select">
                            @foreach (var sortOption in Model.SortOptions)
                            {
                                <option value="@sortOption" selected="@(Model.SelectedSortOption == sortOption)">@sortOption</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Başlangıç Tarihi</label>
                        <input type="date" name="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bitiş Tarihi</label>
                        <input type="date" name="endDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">Filtrele</button>
                    </div>
                </form>
            </div>
        </div>
        
        @if (!Model.Diseases.Any())
        {
            <div class="alert alert-info">
                <p class="mb-0">Arama kriterlerinize uygun hastalık bilgisi bulunamadı. Lütfen farklı filtreler deneyiniz.</p>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var disease in Model.Diseases)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge @(disease.AnimalType == "Kedi" ? "bg-success" : (disease.AnimalType == "Köpek" ? "bg-primary" : "bg-info"))">@disease.AnimalType</span>
                                    <span class="badge bg-secondary ms-2">@disease.Category</span>
                                </div>
                                <span class="badge @(disease.SeverityLevel == "Yüksek" ? "bg-danger" : (disease.SeverityLevel == "Orta" ? "bg-warning" : "bg-success"))">
                                    @disease.SeverityLevel Riskli
                                </span>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">@disease.Name</h5>
                                <p class="card-text">@disease.Description</p>
                                <div class="mt-3">
                                    <h6>Belirtiler:</h6>
                                    <p class="small">@disease.Symptoms</p>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted small">
                                    <i class="far fa-eye me-1"></i> @disease.ViewCount görüntüleme
                                </span>
                                <a asp-controller="Diseases" asp-action="Details" asp-route-id="@disease.Id" class="btn btn-outline-primary">
                                    Detaylı Bilgi
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section> 