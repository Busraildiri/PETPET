@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["Description"] = "PetWork - Evcil hayvan sahipleri için güvenilir bilgi ve topluluk platformu. Sorular, tarifler, hastalık bilgileri ve rehberler.";
    ViewData["Keywords"] = "evcil hayvan, kedi, köpek, kuş, hayvan bakımı, pet community, hayvan hastalıkları, hayvan beslenmesi";
}

<!-- Hero Section Slider -->
<div id="homeSlider" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#homeSlider" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#homeSlider" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#homeSlider" data-bs-slide-to="2"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="hero-slide bg-primary text-white py-5" style="background-image: url('/img/hero-community-v2.png'); background-size: cover; background-position: center;">
                <div class="container py-5">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="bg-dark bg-opacity-50 p-4 rounded shadow">
                                <h1 class="display-4 fw-bold">Evcil Hayvan Sahipleri İçin Güvenilir Bilgi Platformu</h1>
                                <p class="lead">Tüm evcil hayvan bakımı sorularınıza uzmanlar ve deneyimli hayvan sahiplerinden cevaplar bulun.</p>
                                <a href="/Questions" class="btn btn-primary btn-lg">Sorular & Cevaplar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <div class="hero-slide bg-success text-white py-5" style="background-image: url('/img/hero-recipes-v2.png'); background-size: cover; background-position: center;">
                <div class="container py-5">
                    <div class="row">
                        <div class="col-md-6 offset-md-6">
                            <div class="bg-dark bg-opacity-50 p-4 rounded shadow">
                                <h1 class="display-4 fw-bold">Evcil Hayvanınız İçin Sağlıklı Tarifler</h1>
                                <p class="lead">Ev yapımı, doğal ve sağlıklı mama tarifleri ile dostunuzu şımartın.</p>
                                <a href="/Recipes" class="btn btn-success btn-lg">Tarifler</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <div class="hero-slide bg-info text-white py-5" style="background-image: url('/img/hero-health-v2.png'); background-size: cover; background-position: center;">
                <div class="container py-5">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="bg-dark bg-opacity-50 p-4 rounded shadow">
                                <h1 class="display-4 fw-bold">Hayvan Hastalıkları Bilgi Bankası</h1>
                                <p class="lead">Evcil hayvan hastalıkları, belirtileri, tedavi yöntemleri ve korunma hakkında kapsamlı bilgiler.</p>
                                <a href="/Diseases" class="btn btn-info btn-lg text-white">Hastalık Bilgileri</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#homeSlider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
        <span class="visually-hidden">Önceki</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeSlider" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
        <span class="visually-hidden">Sonraki</span>
    </button>
</div>

