@model PetWork.Models.HomeViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["Description"] = "PetWork; evcil hayvanlarla yaşamın bakımı, neşesi, zorlukları ve kayıpları için güvenli bir dayanışma alanı.";
}

<section class="home-hero">
    <div class="container">
        <div class="home-hero-grid">
            <div class="hero-copy">
                <span class="eyebrow"><i class="fa-solid fa-heart"></i> Bakım, bağ ve dayanışma için</span>
                <h1>Onlarla kurduğumuz hayatı, <em>birlikte</em> daha iyi koruyalım.</h1>
                <p>PetWork; merak ettiklerimizi sorduğumuz, öğrendiklerimizi paylaştığımız ve zor zamanlarda birbirimize alan açtığımız bir evcil hayvan topluluğu.</p>
                <div class="hero-actions">
                    <a class="btn btn-petwork-primary btn-lg" asp-controller="Questions" asp-action="Index">Topluluğa göz at <i class="fa-solid fa-arrow-right"></i></a>
                    <a class="btn btn-petwork-ghost btn-lg" asp-controller="Questions" asp-action="Ask">Bir şey paylaş</a>
                </div>
                <div class="hero-promise"><span><i class="fa-solid fa-check"></i> Gerçek deneyimler</span><span><i class="fa-solid fa-check"></i> Kaynağı açık bilgiler</span><span><i class="fa-solid fa-check"></i> Yargısız dayanışma</span></div>
            </div>
            <div class="hero-visual">
                <img src="~/img/petwork-community-hero-our-pets-v2.png" alt="PetWork'ün hikâyesine ilham veren köpek ve kedinin birlikte olduğu sıcak illüstrasyon" />
                <div class="hero-note"><i class="fa-regular fa-heart"></i><span><strong>Her hikâye burada değerli.</strong> Güzel anlar da zor vedalar da.</span></div>
            </div>
        </div>
    </div>
</section>

<section class="purpose-strip" aria-label="PetWork yaklaşımı">
    <div class="container purpose-grid">
        <div><span class="purpose-number">01</span><p><strong>Bilgiye zamanında ulaş.</strong><br />Bakım ve sağlık içeriklerini anlaşılır biçimde bul.</p></div>
        <div><span class="purpose-number">02</span><p><strong>Deneyimini paylaş.</strong><br />Başka bir canlının hayatına dokunabilecek olanı anlat.</p></div>
        <div><span class="purpose-number">03</span><p><strong>Yalnız kalma.</strong><br />Kaygıyı, yetersizliği ve kaybı saklamak zorunda değilsin.</p></div>
    </div>
</section>

<section class="home-section path-section">
    <div class="container">
        <div class="section-heading">
            <div><span class="eyebrow">Bugün neye ihtiyacın var?</span><h2>Doğru yerden başlayalım.</h2></div>
            <p>Bir sorunun cevabını arıyor, yaşadığını anlatmak ya da yalnızca başka insanların deneyimlerini okumak istiyor olabilirsin.</p>
        </div>
        <div class="path-grid">
            <a class="path-card path-card-sage" asp-controller="Questions" asp-action="Index"><span class="path-icon"><i class="fa-regular fa-comments"></i></span><span class="path-copy"><small>Topluluğa sor</small><strong>Aklına takılanı paylaş</strong><span>Benzer deneyimlerden ve topluluk bilgisinden yararlan.</span></span><i class="fa-solid fa-arrow-up-right-from-square path-arrow"></i></a>
            <a class="path-card path-card-coral" asp-controller="Diseases" asp-action="Index"><span class="path-icon"><i class="fa-solid fa-kit-medical"></i></span><span class="path-copy"><small>Bakım ve sağlık</small><strong>Belirtileri ve rehberleri incele</strong><span>Bilgilendirici içeriklere ulaş; acil durumda kliniğe başvur.</span></span><i class="fa-solid fa-arrow-up-right-from-square path-arrow"></i></a>
            <a class="path-card path-card-plum" asp-controller="Questions" asp-action="Index" asp-route-category="Yas ve Kayıp"><span class="path-icon"><i class="fa-regular fa-moon"></i></span><span class="path-copy"><small>Yas ve kayıp</small><strong>Onu anlatabileceğin bir alan</strong><span>Vedayı, özlemi ve ardından kalanları yargılanmadan konuş.</span></span><i class="fa-solid fa-arrow-up-right-from-square path-arrow"></i></a>
            <a class="path-card path-card-ochre" asp-controller="Guide" asp-action="Index"><span class="path-icon"><i class="fa-regular fa-compass"></i></span><span class="path-copy"><small>Birlikte yaşam</small><strong>Günlük hayatı kolaylaştır</strong><span>Beslenme, eğitim, oyun ve uyum rehberlerini keşfet.</span></span><i class="fa-solid fa-arrow-up-right-from-square path-arrow"></i></a>
        </div>
    </div>
</section>

<section class="home-section questions-section">
    <div class="container">
        <div class="section-heading section-heading-row">
            <div><span class="eyebrow">Topluluktan</span><h2>Şu sıralar neler konuşuluyor?</h2></div>
            <a class="text-link" asp-controller="Questions" asp-action="Index">Tüm paylaşımları gör <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        @if (Model.FeaturedQuestions.Any())
        {
            <div class="question-grid">
                @foreach (var question in Model.FeaturedQuestions)
                {
                    var username = question.User?.Username ?? "Topluluk üyesi";
                    var initial = username[..1].ToUpperInvariant();
                    var excerpt = question.Content.Length > 145 ? question.Content[..145] + "…" : question.Content;
                    <article class="question-card">
                        <div class="question-card-top"><span class="question-avatar">@initial</span><span><strong>@username</strong><small>@question.CreatedDate.ToString("dd.MM.yyyy")</small></span><span class="soft-tag">@(question.Category ?? "Genel")</span></div>
                        <h3><a asp-controller="Questions" asp-action="Details" asp-route-id="@question.Id">@question.Title</a></h3>
                        <p>@excerpt</p>
                        <div class="question-meta"><span><i class="fa-regular fa-comment"></i> @(question.Answers?.Count ?? 0) cevap</span><span><i class="fa-regular fa-eye"></i> @question.ViewCount görüntülenme</span></div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="honest-empty-state">
                <span class="empty-illustration"><i class="fa-regular fa-message"></i></span>
                <div><h3>İlk gerçek paylaşımı bekliyoruz.</h3><p>Sahte kullanıcılar ve örnek sorular göstermiyoruz. Buradaki her hikâye gerçek bir topluluk üyesine ait olacak.</p></div>
                <a class="btn btn-petwork-primary" asp-controller="Questions" asp-action="Ask">İlk paylaşımı yap</a>
            </div>
        }
    </div>
</section>

<section class="home-section grief-section">
    <div class="container">
        <div class="grief-panel">
            <div class="grief-symbol" aria-hidden="true"><i class="fa-solid fa-seedling"></i></div>
            <div class="grief-copy"><span class="eyebrow">Kaybın ardından</span><h2>Bazı bağlar, vedadan sonra da bizimle kalır.</h2><p>Bir hayvanı kaybetmek “sadece bir evcil hayvanı” kaybetmek değildir. Yaşadıklarını anlatabileceğin, anısını paylaşabileceğin ve benzer kayıpları yaşamış insanlarla konuşabileceğin daha güvenli bir alan kuruyoruz.</p><div class="grief-actions"><a class="btn btn-petwork-light" asp-controller="Questions" asp-action="Index" asp-route-category="Yas ve Kayıp">Paylaşımları oku</a><a class="grief-link" asp-controller="Questions" asp-action="Ask" asp-route-category="Yas ve Kayıp">Onu anlat <i class="fa-solid fa-arrow-right"></i></a></div></div>
            <div class="grief-quote"><i class="fa-solid fa-quote-left"></i><p>Yasın bir takvimi yok. Burada acele etmek zorunda değilsin.</p></div>
        </div>
    </div>
</section>

<section class="home-section content-section">
    <div class="container">
        <div class="section-heading section-heading-row"><div><span class="eyebrow">Bilgi merkezi</span><h2>Daha bilinçli bakım için.</h2></div><a class="text-link" asp-controller="Guide" asp-action="Index">Tüm rehberler <i class="fa-solid fa-arrow-right"></i></a></div>
        <div class="knowledge-grid">
            <a class="knowledge-feature" asp-controller="Diseases" asp-action="Index"><span class="knowledge-label">Sağlık okuryazarlığı</span><h3>Belirtiyi fark etmek ile tanı koymak aynı şey değil.</h3><p>Güvenilir kaynakları anlamayı, doğru soruları sormayı ve ne zaman profesyonel destek gerektiğini öğren.</p><span class="knowledge-action">Sağlık bilgilerini incele <i class="fa-solid fa-arrow-right"></i></span></a>
            <div class="knowledge-stack">
                <a asp-controller="Recipes" asp-action="Index"><span class="knowledge-icon"><i class="fa-solid fa-bowl-food"></i></span><span><small>Beslenme</small><strong>Tarifler ve güvenli malzemeler</strong></span><i class="fa-solid fa-chevron-right"></i></a>
                <a asp-controller="Guide" asp-action="Index"><span class="knowledge-icon"><i class="fa-solid fa-paw"></i></span><span><small>Bakım</small><strong>Türüne ve yaşam evresine göre rehberler</strong></span><i class="fa-solid fa-chevron-right"></i></a>
                <a asp-controller="Blog" asp-action="Index"><span class="knowledge-icon"><i class="fa-regular fa-lightbulb"></i></span><span><small>Deneyim</small><strong>Topluluktan yazılar ve fikirler</strong></span><i class="fa-solid fa-chevron-right"></i></a>
            </div>
        </div>
    </div>
</section>

<section class="home-cta">
    <div class="container"><div class="cta-inner"><div><span class="eyebrow">PetWork büyürken</span><h2>Bildiklerini paylaş. Bilmediklerini sor. Hikâyeni saklama.</h2></div><a class="btn btn-petwork-primary btn-lg" asp-controller="Questions" asp-action="Ask">Topluluğa katıl <i class="fa-solid fa-arrow-right"></i></a></div></div>
</section>
