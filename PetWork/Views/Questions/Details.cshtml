@model Question
@{
    ViewData["Title"] = Model.Title;
    var externalSource = ViewBag.ExternalSource as PetWork.Models.ExternalContentSource;
    var externalAnswers = ViewBag.ExternalAnswerSources as Dictionary<int, PetWork.Models.ExternalContentSource> ?? new();
    var currentUserId = ViewBag.CurrentUserId as int?;
    var canAcceptAnswer = ViewBag.CanAcceptAnswer is true;
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
            <li class="breadcrumb-item"><a asp-controller="Questions" asp-action="Index">Soru-Cevap</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Main Content Column -->
        <div class="col-lg-8">
            <!-- Question Card -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">@Model.Title</h2>
                </div>
                <div class="card-body">
                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            @if (externalSource is null) { <img src="@PetWork.Services.MediaUrlResolver.Resolve(Url, Model.User.ProfileImage, "img/user-profile.jpg")" class="rounded-circle" width="50" height="50" alt="User"> }
                            else { <span class="badge" style="background:#62495f">Dış kaynak</span> }
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">@(externalSource?.SourceAuthorName ?? Model.User.Username)</h5>
                                <span class="text-muted">
                                    <i class="fas fa-calendar-alt me-1"></i> @Model.CreatedDate.ToString("dd MMMM yyyy HH:mm")
                                </span>
                            </div>
                            <div>
                                <span class="badge bg-secondary">@Model.Category</span>
                                <span class="badge bg-info"><i class="fas fa-eye me-1"></i> @Model.ViewCount görüntülenme</span>
                            </div>
                        </div>
                    </div>
                    <div class="question-content mb-3">
                        <p>@Model.Content</p>
                    </div>
                    <div class="d-flex justify-content-between">
                        <div>
                            <button class="btn btn-sm btn-outline-primary me-2">
                                <i class="fas fa-share-alt me-1"></i> Paylaş
                            </button>
                            <button class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-bookmark me-1"></i> Kaydet
                            </button>
                        </div>
                        <button class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-flag me-1"></i> Bildir
                        </button>
                    </div>
                </div>
            </div>

            @if (externalSource is not null)
            {
                <partial name="_ExternalSourceAttribution" model="externalSource" />
            }

            <!-- Answers Section -->
            <div class="mb-4">
                <h3 class="mb-3">
                    <span class="badge bg-success me-2">@(Model.Answers?.Count ?? 0)</span> Cevap
                </h3>

                @if (Model.Answers != null && Model.Answers.Any())
                {
                    @foreach (var answer in Model.Answers.OrderByDescending(a => a.IsAccepted).ThenByDescending(a => a.UpVotes - a.DownVotes))
                    {
                        var answerSource = externalAnswers.GetValueOrDefault(answer.Id);
                        <div class="card mb-3 answer-card @(answer.IsAccepted ? "accepted-answer-card" : "")">
                            @if (answer.IsAccepted)
                            {
                                <div class="card-header accepted-answer-header">
                                    <i class="fas fa-circle-check me-2"></i> Soru sahibi bu cevabı kabul etti
                                </div>
                            }
                            <div class="card-body">
                                <div class="d-flex">
                                    <div class="flex-shrink-0 me-3 text-center">
                                        <button class="btn btn-sm btn-outline-success d-block mb-1 vote-btn" onclick="vote(this, @answer.Id, 'up')">
                                            <i class="fas fa-chevron-up"></i>
                                        </button>
                                        <div class="vote-count my-1">@(answer.UpVotes - answer.DownVotes)</div>
                                        <button class="btn btn-sm btn-outline-danger d-block vote-btn" onclick="vote(this, @answer.Id, 'down')">
                                            <i class="fas fa-chevron-down"></i>
                                        </button>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex mb-3">
                                            <div class="flex-shrink-0">
                                                <img src="@PetWork.Services.MediaUrlResolver.Resolve(Url, answer.User.ProfileImage, "img/user-profile.jpg")" class="rounded-circle" width="40" height="40" alt="User">
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <div class="d-flex justify-content-between align-items-center">
                                                <h5 class="mb-0">@(answerSource?.SourceAuthorName ?? answer.User.Username)</h5>
                                                    <span class="text-muted">
                                                        <i class="fas fa-calendar-alt me-1"></i> @answer.CreatedDate.ToString("dd MMMM yyyy HH:mm")
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="answer-content mb-3">
                                            <p>@answer.Content</p>
                                        </div>
                                        @if (answerSource is not null)
                                        {
                                            <partial name="_ExternalSourceAttribution" model="answerSource" />
                                        }
                                        <div class="d-flex justify-content-between">
                                            <div>
                                                <button class="btn btn-sm btn-outline-primary me-2" onclick="showCommentForm(@answer.Id)">
                                                    <i class="fas fa-comment me-1"></i> Yorum Ekle
                                                </button>
                                                @if (canAcceptAnswer && answer.UserId != currentUserId)
                                                {
                                                    <form asp-controller="Questions" asp-action="AcceptAnswer" asp-route-id="@answer.Id"
                                                          method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-sm accept-answer-btn">
                                                            <i class="fas fa-check me-1"></i> En iyi cevap olarak kabul et
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-flag me-1"></i> Bildir
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <p class="mb-0">Henüz cevap yok. İlk cevabı siz verin!</p>
                    </div>
                }
            </div>

            <!-- Add Answer Form -->
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Cevabınız</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="Questions" asp-action="Answer" asp-route-id="@Model.Id" method="post">
                        <div class="mb-3">
                            <textarea class="form-control" name="Content" rows="6" placeholder="Cevabınızı buraya yazın..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Cevabı Gönder</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar Column -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body p-4">
                    <span class="eyebrow mb-2">Benzer konuşmalar</span>
                    <h4>Aynı konuda gerçek paylaşımlara göz atın.</h4>
                    <p class="text-muted small">Hazır örnek sorular yerine toplulukta gerçekten yayımlanmış içerikleri gösteriyoruz.</p>
                    <a asp-controller="Questions" asp-action="Index" asp-route-category="@Model.Category" class="btn btn-outline-primary w-100">@(Model.Category ?? "Genel") paylaşımlarını gör</a>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">Soru Sorma İpuçları</h4>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i> 
                            Net ve açık sorular sorun
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i> 
                            Evcil hayvanınızın yaşı, cinsi ve ırkı gibi detayları paylaşın
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i> 
                            Mümkünse fotoğraf ekleyin
                        </li>
                        <li>
                            <i class="fas fa-check-circle text-success me-2"></i> 
                            Daha önce denediğiniz çözümleri belirtin
                        </li>
                    </ul>
                    <div class="mt-3">
                        <a asp-controller="Questions" asp-action="Ask" class="btn btn-primary w-100">Yeni Soru Sor</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function vote(button, answerId, voteType) {
            // In a real application, this would make an AJAX call to the server
            console.log(`Vote ${voteType} for answer ${answerId}`);
            
            const voteCount = button.parentElement.querySelector('.vote-count');
            const currentCount = parseInt(voteCount.innerText);
            
            if (voteType === 'up') {
                voteCount.innerText = currentCount + 1;
            } else {
                voteCount.innerText = currentCount - 1;
            }
        }
        
        function showCommentForm(answerId) {
            alert(`Comment form for answer ${answerId} would show here`);
        }
    </script>
} 
