@model List<PetWork.Models.BlogPost>
@{
    ViewData["Title"] = "Blog Yönetimi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Blog Yönetimi</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Admin Paneline Dön</a>
    </div>
    <partial name="_Messages" />
    <div class="card shadow-sm"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Başlık</th><th>Kategori</th><th>Yazar</th><th>Görüntülenme</th><th class="text-end">İşlem</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td><td>@item.Category</td><td>@(item.User?.Username ?? "Bilinmiyor")</td><td>@item.ViewCount</td>
                    <td class="text-end"><a asp-action="EditContent" asp-route-type="blog" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit me-1"></i>İncele / Düzenle</a><form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bu blog yazısını kalıcı olarak silmek istiyor musunuz?');">
                        <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="type" value="blog" />
                        <button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-trash me-1"></i>Sil</button>
                    </form></td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
</div>
