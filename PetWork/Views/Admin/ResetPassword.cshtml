@model PetWork.Models.ViewModels.AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Kullanıcı şifresini sıfırla";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h2 mb-1">Şifreyi sıfırla</h1>
                    <p class="text-muted mb-0"><strong>@Model.Username</strong> kullanıcısı için yeni geçici şifre belirleyin.</p>
                </div>
                <a asp-action="Users" class="btn btn-outline-secondary">Geri dön</a>
            </div>

            <div class="alert alert-warning">
                Kullanıcının mevcut şifresi görüntülenemez. Kaydettiğinizde eski şifre geçersiz olur; yeni şifreyi kullanıcıya güvenli bir kanaldan iletin.
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="ResetPassword" method="post">
                        <input asp-for="UserId" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-key me-1"></i>Şifreyi güncelle
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
