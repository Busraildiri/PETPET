@model List<PetWork.Models.User>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    var currentUserId = ViewBag.CurrentUserId as int?;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Kullanıcı Yönetimi</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Admin Paneline Dön</a>
    </div>
    <partial name="_Messages" />
    <div class="alert alert-warning">
        Bir kullanıcı silindiğinde kullanıcıya ait sorular, cevaplar, tarifler ve diğer bağlı içerikler de silinir.
    </div>
    <div class="card shadow-sm"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Kullanıcı</th><th>E-posta</th><th>Kayıt Tarihi</th><th>Rol</th><th class="text-end">İşlem</th></tr></thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Username @if (user.Id == currentUserId) { <span class="badge bg-info">Siz</span> }</td>
                    <td>@user.Email</td><td>@user.RegistrationDate.ToString("dd.MM.yyyy")</td>
                    <td><span class="badge @(user.IsAdmin ? "bg-primary" : "bg-secondary")">@(user.IsAdmin ? "Admin" : "Kullanıcı")</span></td>
                    <td class="text-end">
                        @if (user.Id == currentUserId)
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled>Kendi hesabınız</button>
                        }
                        else
                        {
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bu kullanıcı ve bağlı tüm içerikleri kalıcı olarak silinsin mi?');">
                                <input type="hidden" name="id" value="@user.Id" /><input type="hidden" name="type" value="user" />
                                <button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-trash me-1"></i>Sil</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
</div>
