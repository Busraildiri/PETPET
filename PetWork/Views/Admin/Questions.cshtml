@model List<PetWork.Models.Question>
@{
    ViewData["Title"] = "Soru Yönetimi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Soru Yönetimi</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Admin Paneline Dön</a>
    </div>
    <partial name="_Messages" />
    <div class="card shadow-sm"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Başlık</th><th>Kategori</th><th>Soran</th><th>Tarih</th><th class="text-end">İşlem</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td><td>@(item.Category ?? "Genel")</td><td>@(item.User?.Username ?? "Bilinmiyor")</td><td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                    <td class="text-end"><form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bu soru ve tüm cevapları kalıcı olarak silinsin mi?');">
                        <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="type" value="question" />
                        <button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-trash me-1"></i>Sil</button>
                    </form></td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
</div>
