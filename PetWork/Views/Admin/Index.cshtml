@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="mb-1">Admin Paneli</h1><p class="text-muted mb-0">Platformdaki kullanıcıları ve içerikleri yönetin.</p></div>
    </div>
    <partial name="_Messages" />

    <div class="row g-4">
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-start border-primary border-4"><div class="card-body">
                <div class="d-flex justify-content-between"><div><h5>Kullanıcılar</h5><div class="display-6">@ViewBag.UsersCount</div></div><i class="fas fa-users fa-2x text-primary"></i></div>
                <a asp-action="Users" class="btn btn-outline-primary w-100 mt-3">Kullanıcıları Yönet</a>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-start border-success border-4"><div class="card-body">
                <div class="d-flex justify-content-between"><div><h5>Tarifler</h5><div class="display-6">@ViewBag.RecipesCount</div></div><i class="fas fa-utensils fa-2x text-success"></i></div>
                <a asp-action="Recipes" class="btn btn-outline-success w-100 mt-3">Tarifleri Yönet</a>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-start border-info border-4"><div class="card-body">
                <div class="d-flex justify-content-between"><div><h5>Hastalıklar</h5><div class="display-6">@ViewBag.DiseasesCount</div></div><i class="fas fa-stethoscope fa-2x text-info"></i></div>
                <a asp-action="Diseases" class="btn btn-outline-info w-100 mt-3">Hastalıkları Yönet</a>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-start border-warning border-4"><div class="card-body">
                <div class="d-flex justify-content-between"><div><h5>Rehberler</h5><div class="display-6">@ViewBag.GuidesCount</div></div><i class="fas fa-book fa-2x text-warning"></i></div>
                <a asp-action="Guides" class="btn btn-outline-warning w-100 mt-3">Rehberleri Yönet</a>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-start border-danger border-4"><div class="card-body">
                <div class="d-flex justify-content-between"><div><h5>Sorular</h5><div class="display-6">@ViewBag.QuestionsCount</div></div><i class="fas fa-question-circle fa-2x text-danger"></i></div>
                <a asp-action="Questions" class="btn btn-outline-danger w-100 mt-3">Soruları Yönet</a>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-start border-secondary border-4"><div class="card-body">
                <div class="d-flex justify-content-between"><div><h5>Blog Yazıları</h5><div class="display-6">@ViewBag.BlogsCount</div></div><i class="fas fa-newspaper fa-2x text-secondary"></i></div>
                <a asp-action="Blogs" class="btn btn-outline-secondary w-100 mt-3">Blogları Yönet</a>
            </div></div>
        </div>
    </div>
</div>
