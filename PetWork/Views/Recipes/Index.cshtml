@model PetWork.Models.ViewModels.RecipeViewModel

@{
    ViewData["Title"] = "Evcil Hayvan Tarifleri";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="mb-3">Evcil Hayvan Tarifleri</h1>
                <p class="lead">Evcil hayvanınız için sağlıklı ve lezzetli ev yapımı tarif önerileri</p>
            </div>
            <div class="col-md-4 text-md-end">
                <button class="btn btn-outline-primary mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
                    <i class="fas fa-filter me-2"></i> Filtreleme Seçenekleri
                </button>
            </div>
        </div>
        
        <div class="collapse mb-4" id="filterCollapse">
            <div class="card card-body">
                <form asp-controller="Recipes" asp-action="Index" method="get" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Hayvan Türü</label>
                        <select name="animalType" class="form-select">
                            <option value="">Tümü</option>
                            @foreach (var animalType in Model.AnimalTypes)
                            {
                                <option value="@animalType" selected="@(Model.SelectedAnimalType == animalType)">@animalType</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Zorluk Seviyesi</label>
                        <select name="difficulty" class="form-select">
                            <option value="">Tümü</option>
                            @foreach (var difficulty in Model.Difficulties)
                            {
                                <option value="@difficulty" selected="@(Model.SelectedDifficulty == difficulty)">@difficulty</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Sıralama</label>
                        <select name="sortOption" class="form-select">
                            @foreach (var sortOption in Model.SortOptions)
                            {
                                <option value="@sortOption" selected="@(Model.SelectedSortOption == sortOption)">@sortOption</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Başlangıç Tarihi</label>
                        <input type="date" name="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bitiş Tarihi</label>
                        <input type="date" name="endDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Filtrele</button>
                    </div>
                </form>
            </div>
        </div>
        
        @if (!Model.Recipes.Any())
        {
            <div class="alert alert-info">
                <p class="mb-0">Arama kriterlerinize uygun tarif bulunamadı. Lütfen farklı filtreler deneyiniz.</p>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var recipe in Model.Recipes)
                {
                    var recipeImage = string.IsNullOrWhiteSpace(recipe.ImageUrl) || recipe.ImageUrl == "img/recipe-default.jpg" ||
                                      recipe.ImageUrl is "img/recipes/recipe1.jpg" or "img/recipes/recipe2.jpg" or "img/recipes/recipe3.jpg"
                        ? "img/hero-recipes-v2.png" : recipe.ImageUrl;
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div class="card-header bg-transparent border-0">
                                <span class="badge @(recipe.AnimalType == "Kedi" ? "bg-success" : (recipe.AnimalType == "Köpek" ? "bg-primary" : "bg-info"))">@recipe.AnimalType</span>
                                <span class="badge bg-secondary ms-2">@recipe.Difficulty</span>
                            </div>
                            <img src="@PetWork.Services.MediaUrlResolver.Resolve(Url, recipeImage, "img/hero-recipes-v2.png")" class="card-img-top" alt="@recipe.Title">
                            <div class="card-body">
                                <h5 class="card-title">@recipe.Title</h5>
                                <p class="card-text">@recipe.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">
                                        <i class="far fa-clock me-1"></i> @recipe.PreparationTime dk
                                    </span>
                                    <span class="text-muted small">
                                        <i class="far fa-eye me-1"></i> @recipe.ViewCount
                                    </span>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-outline-primary">Tarifi Gör</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section> 
