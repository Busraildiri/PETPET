# Copy to /etc/petwork/backup.env, replace placeholders, then chmod 600.
# Use the direct PostgreSQL connection, not the transaction pooler.
PETWORK_BACKUP_DATABASE_URL='postgresql://backup_role:REPLACE_ME@db.example.com:5432/postgres?sslmode=require'

# Must point to the production MediaStorage__StoragePath.
PETWORK_MEDIA_PATH=/mnt/petim-media

# Prefer an encrypted repository in another provider/account and region.
# Examples: s3:s3.example.net/petwork-backups or sftp:backup-host:/srv/petwork
RESTIC_REPOSITORY='s3:s3.other-provider.example/petwork-backups'
RESTIC_PASSWORD_FILE=/etc/petwork/restic-password
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

PETWORK_BACKUP_KEEP_DAILY=30
PETWORK_BACKUP_KEEP_WEEKLY=12
PETWORK_BACKUP_KEEP_MONTHLY=12
