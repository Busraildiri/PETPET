[Unit]
Description=PetWork encrypted PostgreSQL and media backup
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/petwork/backup.env

[Service]
Type=oneshot
User=petwork-backup
Group=petwork-backup
EnvironmentFile=/etc/petwork/backup.env
ExecStart=/usr/bin/bash /opt/petwork/ops/data-resilience/backup-postgresql.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=-/mnt/petim-media

[Install]
WantedBy=multi-user.target
